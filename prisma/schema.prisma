// Prisma schema

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Generator for Prisma Client

generator client {
  provider = "prisma-client-js"
}

model Project {
  id       Int      @id @default(autoincrement())
  title    String
  slug     String   @unique
  tech     String[]
  repoUrl  String
  coverImg String
  blurb    String?
  body     String
}

model BlogPost {
  id        Int      @id @default(autoincrement())
  title     String
  slug      String   @unique
  tags      String[]
  coverImg  String
  excerpt   String?
  body      String
  createdAt DateTime @default(now())
}

model ContactMessage {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  subject   String?
  body      String
  createdAt DateTime @default(now())
}
